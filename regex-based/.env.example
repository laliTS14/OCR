# --- Unlimited-OCR microservice — reused, not duplicated ---
# This demo does NOT run its own copy of the Unlimited-OCR model. It calls
# the SAME already-running Python microservice ../unlimited-ocr/ uses
# (unlimited_ocr_service.py, ~6.67GB of weights — not worth a second copy).
# Start it from ../unlimited-ocr/ as usual and point this demo at it. Only
# used when a file has no digital text layer (a real scan) — every digital
# PDF skips this entirely via the free text-layer shortcut.
UNLIMITED_OCR_URL=http://localhost:8796

# Rasterization width for PDF pages before they're sent to Unlimited-OCR.
PAGE_RENDER_WIDTH=1600

# Local port for this demo's own Node server (server.js). Different from
# ../unlimited-ocr/'s 8795 so both can run side by side for comparison.
PORT=8797

# No OLLAMA_URL / CATEGORIZE_MODEL here on purpose — this demo's
# categorization step (regexCategorize.js) never calls an LLM.
