# Paste your Sarvam AI API key below, then save this file as `.env`.
# Get one at https://dashboard.sarvam.ai
# Never commit the real `.env` file or share the key — treat it like a password.
# If a key was ever pasted somewhere non-private (chat, a ticket, a screenshot),
# treat it as compromised and regenerate it from the dashboard before using it here.
SARVAM_API_KEY=REPLACE_WITH_YOUR_SARVAM_API_KEY

# Base URL for Sarvam's API — shouldn't need to change this.
SARVAM_BASE_URL=https://api.sarvam.ai

# Language hint passed to the Extract job. Sarvam supports all 22 scheduled
# Indian languages plus English — see docs.sarvam.ai for the full language
# code list. en-IN is a reasonable default for English-language DC reports.
SARVAM_LANGUAGE=en-IN

# Local port for the server.
PORT=8790
