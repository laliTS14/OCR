# --- DeepSeek-OCR (does the actual reading/OCR step) — runs entirely through
# Ollama, no separate Python microservice needed (unlike ../paddleocr/) ---
# Install Ollama (https://ollama.com), then run: ollama pull deepseek-ocr
# Make sure `ollama serve` is running (it usually auto-starts after install).
OLLAMA_URL=http://localhost:11434
DEEPSEEK_OCR_MODEL=deepseek-ocr

# --- Local small LLM via Ollama (does only the categorization step) ---
# Run: ollama pull llama3.2:3b (or reuse whatever ../paddleocr/ already has)
CATEGORIZE_MODEL=llama3.2:3b

# Rasterization DPI-equivalent for PDF pages before they're sent to
# DeepSeek-OCR (it only accepts images, not PDFs) — passed as desiredWidth
# to pdf-parse's built-in renderer. Higher = clearer text, slower + more
# prompt tokens per page.
PAGE_RENDER_WIDTH=1600

# Local port for the Node server (server.js).
PORT=8793
