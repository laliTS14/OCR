# --- Azure Document Intelligence (does the actual reading/OCR/table detection) ---
# Create a free resource at https://portal.azure.com (search "Document Intelligence",
# F0/free pricing tier gives ~500 pages/month). Then copy its Endpoint and Key
# from the resource's "Keys and Endpoint" page and paste them below.
AZURE_DOCINTEL_ENDPOINT=REPLACE_WITH_YOUR_AZURE_ENDPOINT
AZURE_DOCINTEL_KEY=REPLACE_WITH_YOUR_AZURE_KEY

# --- Local small LLM via Ollama (does only the categorization step) ---
# Install Ollama (https://ollama.com), then run: ollama pull llama3.2:3b
# Make sure `ollama serve` is running (it usually auto-starts after install).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local port for this server.
PORT=8788
