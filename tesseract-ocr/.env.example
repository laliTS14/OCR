# Local port for the Node demo (server.js).
PORT=8800

# --- OCR engines (ocrEngines.js — same file as paddleocr/) ---
# This folder reads scanned pages with Tesseract by default.
OCR_PRIMARY_ENGINE=tesseract
OCR_ENGINE_PADDLE_ENABLED=true
OCR_ENGINE_TESSERACT_ENABLED=true
OCR_ENGINE_GEMINI_ENABLED=false
# Double OCR is driven from paddleocr/ (Tesseract is always the SECOND engine),
# so it stays off here.
OCR_DOUBLE_ENABLED=false
TESSERACT_TEXT_URL=http://localhost:8799
PADDLE_TEXT_URL=http://localhost:8794
# Width pages are rendered at before OCR (the service scales up to TESSERACT_TARGET_WIDTH).
PAGE_RENDER_WIDTH=1600

# --- Local small LLM via Ollama (only for the "Rules, AI fallback" / "AI only" options) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
