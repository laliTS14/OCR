# --- Unlimited-OCR microservice (unlimited_ocr_service.py) — does the actual
# reading. Runs on forced CPU (no GPU on this machine) — see PROGRESS.md /
# unlimited_ocr_service.py's file header for what that took to get working.
# No API key needed, it's fully local. Just tell the Node server where it's
# listening. ~4.5 min per page confirmed — start it separately and leave it
# running (model load happens once at startup, not per-request).
UNLIMITED_OCR_URL=http://localhost:8796

# --- Local small LLM via Ollama (does only the categorization step) ---
# Run: ollama pull llama3.2:3b (or reuse whatever ../paddleocr/ already has)
OLLAMA_URL=http://localhost:11434
CATEGORIZE_MODEL=llama3.2:3b

# Rasterization width for PDF pages before they're sent to Unlimited-OCR
# (it only accepts images, not PDFs) — same approach as ../deepseek-ocr/.
PAGE_RENDER_WIDTH=1600

# Local port for the Node server (server.js).
PORT=8795
