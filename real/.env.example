# Paste your Gemini API key below, then save this file as `.env`.
# Get one at https://aistudio.google.com/apikey
# Never commit the real `.env` file or share the key — treat it like a password.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# Model to use.
GEMINI_MODEL=gemini-3.6-flash

# Local port for the server.
PORT=8787
