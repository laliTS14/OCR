# --- PaddleOCR microservice (paddle_service.py) — does the actual reading/OCR/table detection ---
# No API key needed, it's fully local. Just tell the Node server where it's listening.
PADDLE_OCR_URL=http://localhost:8791

# --- Local small LLM via Ollama (does only the categorization step) ---
# Install Ollama (https://ollama.com), then run: ollama pull llama3.2:3b
# Make sure `ollama serve` is running (it usually auto-starts after install).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local port for the Node server (server.js).
PORT=8792
