# --- PaddleOCR microservice (paddle_service.py) — does the actual reading/OCR/table detection ---
# No API key needed, it's fully local. Just tell the Node server where it's listening.
PADDLE_OCR_URL=http://localhost:8791

# --- Local small LLM via Ollama (does only the categorization step) ---
# Install Ollama (https://ollama.com), then run: ollama pull llama3.2:3b
# Make sure `ollama serve` is running (it usually auto-starts after install).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Local port for the Node server (server.js).
PORT=8792

# --- PaddleOCR text-OCR service (paddle_text_service.py) — the default OCR engine ---
# Only pages without a usable PDF text layer are sent here.
PADDLE_TEXT_URL=http://localhost:8794
# Width pages are rendered at before OCR.
PAGE_RENDER_WIDTH=1600

# --- OCR engines (ocrEngines.js) ---
# Engine for pages without a usable text layer: paddle (paddle_text_service.py) | tesseract | gemini (not built yet)
OCR_PRIMARY_ENGINE=paddle
OCR_ENGINE_PADDLE_ENABLED=true
OCR_ENGINE_TESSERACT_ENABLED=true
OCR_ENGINE_GEMINI_ENABLED=false
# Double OCR master switch. A report is double-OCR'd only when this is true AND
# its tbl_ocr_report_details.double_ocr = 1 (or --double / the UI checkbox).
# The second engine is always Tesseract (../tesseract-ocr/tesseract_text_service.py).
OCR_DOUBLE_ENABLED=false
TESSERACT_TEXT_URL=http://localhost:8799

# --- PIMS OCR worker (worker.js) — talks to the OCR API (backend/Health_360_OCR) ---
# The API's URL and its OcrApi:ApiKey (sent as X-Api-Key). Required.
OCR_API_URL=https://localhost:7196
OCR_API_KEY=
# 1 = accept the API's self-signed dev certificate (local/UAT only).
OCR_API_INSECURE_TLS=0
# Where the uploaded report files are: a local folder (worker on the file
# server) or the base URL they are downloaded from — one of the two.
REPORT_UPLOAD_BASE_FOLDER=
REPORT_UPLOAD_BASE_URL=
# rules (default, no LLM) | auto (Ollama only for sections the rules can't read) | llm
OCR_WORKER_ENGINE=rules
OCR_WORKER_CONCURRENCY=1
OCR_WORKER_POLL_MS=5000
# Optional label saved with each result (default: the git commit).
PIPELINE_VERSION=
