# --- Unlimited-OCR microservice — reused, not duplicated (same as ../regex-based/) ---
# Only reached for genuine scans with no digital text layer.
UNLIMITED_OCR_URL=http://localhost:8796
PAGE_RENDER_WIDTH=1600

# --- Ollama LLM fallback — only called when the regex path's confidence
# score is below threshold (see confidence.js). Run: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
CATEGORIZE_MODEL=llama3.2:3b

# Local port for this demo's own Node server. Different from
# ../unlimited-ocr/'s 8795 and ../regex-based/'s 8797.
PORT=8798
